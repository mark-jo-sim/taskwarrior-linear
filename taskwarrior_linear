def next_steps_of(path):
    """Text of a note's `## Next steps` section (to the next heading or EOF),
    or None if the note has no such section."""
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return None
    out, capturing = [], False
    for line in lines:
        if re.fullmatch(r"##\s+Next steps\s*", line):
            capturing = True
            continue
        if capturing and re.match(r"#{1,6}\s", line):
            break  # any next heading ends the section
        if capturing:
            out.append(line)
    return "\n".join(out).strip() or None if capturing else None


def cmd_sod(args):
