# --------------------------------------------------------------------------
# Work-directory mapping (cwd ↔ tasks)
#
# ~/.config/taskwarrior_linear/workdirs.toml:
#
#   [project."VOIP.asr-llm-driven-asr-error-detection"]
#   dirs = ["~/projects/asr-eval"]
#   [project."VOIP"]                       # team-level fallback
#   dirs = ["~/projects/voip"]
#   [task."VOIP-5914"]                     # per-issue dirs, added to project's
#   dirs = ["~/projects/data-sampling"]
#
# Resolution per task (most specific first): `workdir` UDA on the task →
# [task.IDENT] → [project.TEAM.slug] → [project.TEAM]. Subtasks inherit via
# their root issue-task's project. A task matches a cwd when any resolved dir
# is an ancestor of it (recursive).

WORKDIRS_FILE = Path.home() / ".config" / "taskwarrior_linear" / "workdirs.toml"


def load_workdirs():
    if not WORKDIRS_FILE.exists():
        return {"project": {}, "task": {}}
    try:
        import tomllib
    except ImportError:
        die(f"{WORKDIRS_FILE} requires Python 3.11+ (tomllib)")
    with open(WORKDIRS_FILE, "rb") as f:
        data = tomllib.load(f)
    return {"project": data.get("project", {}), "task": data.get("task", {})}


def expand_dir(d):
    return Path(str(d)).expanduser().resolve()


def dirs_for_task(t, project, cfg, extra=None):
    """Work dirs resolved for task t (project may be inherited for subtasks).
    `extra` = dirs inherited from a milestone umbrella (see here_tasks)."""
    dirs = list(extra or [])
    if t.get("workdir"):
        dirs.append(expand_dir(t["workdir"]))
    # [task] section is keyed by any Linear identifier: issue ident,
    # milestone uuid, or project slugId
    for k in (t.get("linear"), t.get("linearmilestone"), t.get("linearproject")):
        if k and k in cfg["task"]:
            dirs += [expand_dir(d) for d in cfg["task"][k]["dirs"]]
    if project:
        if project in cfg["project"]:
            dirs += [expand_dir(d) for d in cfg["project"][project]["dirs"]]
        team = project.split(".")[0]
        if team != project and team in cfg["project"]:
            dirs += [expand_dir(d) for d in cfg["project"][team]["dirs"]]
    seen, out = set(), []
    for d in dirs:
        if d not in seen:
            seen.add(d)
            out.append(d)
    return out


def here_tasks(cwd):
    """Pending tasks whose resolved work dirs cover cwd."""
    cwd = expand_dir(cwd)
    cfg = load_workdirs()
    pending = tw_json("status:pending")
    # milestone dirs apply recursively to the milestone's issue-tasks: the
    # umbrella depends on them, so map depends-uuid -> dirs once
    ms_dirs = {}
    for t in pending:
        ms = t.get("linearmilestone")
        if ms and ms in cfg["task"]:
            ds = [expand_dir(d) for d in cfg["task"][ms]["dirs"]]
            for u in t.get("depends") or []:
                ms_dirs.setdefault(u, []).extend(ds)
    out = []
    for t in pending:
        project = t.get("project")
        root = None
        if not project and t.get("linear"):
            root = root_issue_task(t["linear"])
            project = (root or {}).get("project")
        # milestone dirs reach the issue-task itself and its local subtasks
        extra = ms_dirs.get(t["uuid"]) or (root and ms_dirs.get(root["uuid"]))
        dirs = dirs_for_task(t, project, cfg, extra)
        if any(cwd.is_relative_to(d) for d in dirs):
            t = dict(t)
            t["_here_project"] = project
            out.append(t)
    return out


WORKDIRS_HEADER = """\
# Work-directory mapping for taskwarrior_linear `here`.
# A task matches a directory when any resolved dir is an ancestor of it.
# Resolution per task (most specific first):
#   `workdir` UDA on the task → [task."<issue ident or milestone uuid>"]
#   → [project."TEAM.slug"] → [project."TEAM"]. Milestone dirs apply to the
#   milestone's issue-tasks as well.
# Managed by `taskwarrior_linear map` — regenerated on each change, so
# inline comments here do not survive; keep notes elsewhere.
"""


def save_workdirs(cfg):
    lines = [WORKDIRS_HEADER]
    for kind in ("project", "task"):
        for key in sorted(cfg[kind]):
            lines.append(f'[{kind}."{key}"]')
            vals = ", ".join(json.dumps(d) for d in cfg[kind][key]["dirs"])
            lines.append(f"dirs = [{vals}]")
            lines.append("")
    WORKDIRS_FILE.parent.mkdir(parents=True, exist_ok=True)
    WORKDIRS_FILE.write_text("\n".join(lines) + "\n")


def resolve_map_ref(ref):
    """ref → (section, key) in workdirs config.

    Accepts: Linear issue ident · taskwarrior id/uuid (routed by the task's
    UDAs: issue ident, milestone uuid, or TW project key) · milestone 8-hex
    prefix · TW project key (TEAM or TEAM.slug).
    """
    if ISSUE_RE.match(ref):
        return "task", ref
    if re.fullmatch(r"\d+", ref) or re.fullmatch(r"[0-9a-f-]{36}", ref):
        t = resolve(ref)
        if t.get("linearmilestone"):
            return "task", t["linearmilestone"]
        if t.get("linear"):
            return "task", t["linear"]
        if t.get("linearproject") and t.get("project"):
            return "project", t["project"]
        die(
            f"task {t['id']} has no Linear linkage — map its project key "
            f"instead, e.g. `map {t.get('project') or 'TEAM'} <dir>`"
        )
    if re.fullmatch(r"[0-9a-f]{8}", ref):
        matches = [m for m in fetch_milestones() if m["id"].startswith(ref)]
        if not matches:
            die(f"no milestone id starts with {ref}")
        if len(matches) > 1:
            die(f"ambiguous milestone prefix {ref} — use the full uuid")
        return "task", matches[0]["id"]
    if re.fullmatch(r"[A-Z][A-Z0-9]*(\.[^\s]+)?", ref):
        return "project", ref
    die(
        f"unrecognized ref: {ref} (issue ident, task id/uuid, milestone "
        f"prefix, or TW project key)"
    )


def cmd_map(args):
    cfg = load_workdirs()
    kind, key = resolve_map_ref(args.ref)
    entry = cfg[kind].setdefault(key, {"dirs": []})
    dirpath = os.path.abspath(args.directory)
    if args.remove:
        entry["dirs"] = [d for d in entry["dirs"] if d != dirpath]
        if not entry["dirs"]:
            del cfg[kind][key]
        print(f'unmapped {kind}."{key}": {dirpath}')
    else:
        if dirpath not in entry["dirs"]:
            entry["dirs"].append(dirpath)
        print(
            f'mapped {kind}."{key}": {[dirpath] + [d for d in entry["dirs"] if d != dirpath]}'
        )
    save_workdirs(cfg)
    print(f"  {WORKDIRS_FILE}")


def context_filter(kind, key):
    """(filter, context-name) for a resolved map ref. Contexts are read-only
    (no write filter — new tasks are not auto-tagged)."""
    if kind == "project":
        # TW `project:` filters prefix-match dotted children (VOIP matches
        # VOIP.asr-...), and subtasks inherit their parent's project
        return f"project:{key}", key.lower().replace(".", "-")
    if ISSUE_RE.match(key):
        # issue-task + its local subtasks share the linear UDA
        return f"linear:{key}", key.lower()
    # milestone uuid: umbrella + its issue-tasks (+ their subtasks, which
    # share the issues' linear UDA)
    pending = tw_json("status:pending")
    umbrella = next((t for t in pending if t.get("linearmilestone") == key), None)
    parts = [f"linearmilestone:{key}"]
    if umbrella:
        for u in umbrella.get("depends") or []:
            t = next((x for x in pending if x["uuid"] == u), None)
            if t and t.get("linear"):
                parts.append(f"linear:{t['linear']}")
    return " or ".join(parts), "ms-" + key[:8]


def cmd_context(args):
    if args.ref == "none":
        task("context", "none")
        print("taskwarrior context cleared")
        return
    if args.ref == "list":
        print(task("context", "list"))
        return
    kind, key = resolve_map_ref(args.ref)
    filt, name = context_filter(kind, key)
    # `context define` sets read AND write to the same filter. The write
    # filter auto-applies the filter's attributes to every task added while
    # the context is active — and for milestones the filter is an OR
    # expression, which is meaningless as a write filter. Blank it: these
    # contexts are read-only by design.
    task("context", "define", name, filt)
    task("config", f"context.{name}.write", "")
    task("context", name)
    n = task("count").strip().splitlines()[-1]
    print(f"context '{name}' active — {n} visible")
    print(f"  filter: {filt}")
    print("  clear with: taskwarrior_linear context none")


