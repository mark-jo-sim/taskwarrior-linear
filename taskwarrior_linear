def tw_cutoff(hours=24):
    """UTC cutoff `hours` ago in taskwarrior's YYYYMMDDTHHMMSSZ form. Rolling
    window — never the calendar day, so machines in other timezones agree."""
    return (datetime.now(timezone.utc) - timedelta(hours=hours)).strftime(
        "%Y%m%dT%H%M%SZ"
    )


def cmd_eod(args):
    """End of day: tasks finished/added/changed and notes edited in the last
    24h, plus the latest EOD goals journal."""
    cutoff = tw_cutoff(24)
    all_tasks = tw_json()
    bucketed = set()

    def in_window(t, key):
        return (t.get(key) or "") >= cutoff

    finished = [
        t for t in all_tasks if t.get("status") == "completed" and in_window(t, "end")
    ]
    bucketed |= {t["uuid"] for t in finished}
    removed = [
        t for t in all_tasks if t.get("status") == "deleted" and in_window(t, "end")
    ]
    bucketed |= {t["uuid"] for t in removed}
    added = [
        t for t in all_tasks if in_window(t, "entry") and t["uuid"] not in bucketed
    ]
    bucketed |= {t["uuid"] for t in added}
    changed = [
        t for t in all_tasks if in_window(t, "modified") and t["uuid"] not in bucketed
    ]
    now = datetime.now(timezone.utc).timestamp()
    notes_edited = [
        str(p)
        for p in sorted(TASKS_DIR.glob("*.md"))
        if now - p.stat().st_mtime < 24 * 3600
    ]
    journal = None
    if JOURNALS_DIR.is_dir():
        journals = sorted(
            JOURNALS_DIR.glob("EOD-*.md"), key=lambda p: p.stat().st_mtime, reverse=True
        )
        if journals and now - journals[0].stat().st_mtime < 24 * 3600:
            journal = str(journals[0])
        elif journals:
            journal = str(journals[0])  # stale, but still the newest
    if args.json:
        slim = lambda ts: [
            {
                k: t.get(k)
                for k in (
                    "id",
                    "uuid",
                    "description",
                    "status",
                    "linear",
                    "project",
                    "end",
                    "entry",
                    "modified",
                )
            }
            for t in ts
        ]
        print(
            json.dumps(
                {
                    "cutoff": cutoff,
                    "finished": slim(finished),
                    "removed": slim(removed),
                    "added": slim(added),
                    "changed": slim(changed),
                    "notes_edited": notes_edited,
                    "journal": journal,
                },
                indent=2,
            )
        )
        return
    print(f"last 24h (since {cutoff}):")
    for label, ts in (
        ("finished", finished),
        ("removed", removed),
        ("added", added),
        ("changed", changed),
    ):
        if ts:
            print(f"\n{label}:")
            for t in ts:
                print(f"  {t['id'] or '-':>4}  {t['description']}")
    if notes_edited:
        print("\nnotes edited:")
        for n in notes_edited:
            print(f"  {Path(n).name}")
    print(f"\njournal: {journal or 'none yet — tw-start drafts one'}")


HELP_DESCRIPTION = """\
bridge between Taskwarrior, Linear, and Obsidian notes — issues, projects,
and milestones become tasks; local subtasks stay out of Linear; every task
can carry a note. Runs entirely on your own infra: Linear's GraphQL API,
taskwarrior, and a git repo you control.

typical loop:
  issues → import / import-project → sub "..." → note → done

the linking model and setup live in the README; each command's flags in
`taskwarrior_linear <command> --help`.
"""


def main():
    p = argparse.ArgumentParser(
        prog="taskwarrior_linear",
        description=HELP_DESCRIPTION,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser(
        "issues", help="list my open Linear issues (--json for scripts/pickers)"
    )
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.set_defaults(fn=cmd_issues)

    sp = sub.add_parser(
        "import", help="import one Linear issue (e.g. ENG-123) as a task; idempotent"
    )
    sp.add_argument("issue", help="Linear issue identifier, e.g. ENG-123")
    sp.set_defaults(fn=cmd_import)

    sp = sub.add_parser(
        "projects",
        help="list open projects; --search NAME / --lead me filters server-side",
    )
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.add_argument("--search", help="case-insensitive substring of project name")
    sp.add_argument("--lead", help="project lead (owner): name substring, or 'me'")
    sp.set_defaults(fn=cmd_projects)

    sp = sub.add_parser(
        "milestones", help="list open milestones with their projects and targets"
    )
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.set_defaults(fn=cmd_milestones)

    sp = sub.add_parser(
        "import-project",
        help="import a project: [project] umbrella task + its open issues "
        "(yours by default, --all for everyone's)",
    )
    sp.add_argument("slug", help="Linear project slugId (see `projects`)")
    sp.add_argument(
        "--all",
        action="store_true",
        help="import every open issue, not just ones assigned to you",
    )
    sp.set_defaults(fn=cmd_import_project)

    sp = sub.add_parser(
        "import-milestone",
        help="import a milestone: [milestone] umbrella blocked on its issue-tasks, "
        "plus the issues themselves",
    )
    sp.add_argument(
        "milestone", help="milestone uuid or its 8-char prefix (see `milestones`)"
    )
    sp.add_argument(
        "--all",
        action="store_true",
        help="import every open issue, not just ones assigned to you",
    )
    sp.set_defaults(fn=cmd_import_milestone)

    sp = sub.add_parser(
        "sub",
        help="add a local-only subtask (never pushed to Linear); "
        "the parent issue blocks on it",
    )
    sp.add_argument("ref", help="Linear identifier or taskwarrior task id")
    sp.add_argument("description", nargs="+", help="subtask description")
    sp.set_defaults(fn=cmd_sub)

    sp = sub.add_parser(
        "note", help="create/open the task's Obsidian note (--print for the path only)"
    )
    sp.add_argument("ref", help="taskwarrior task id, uuid, or Linear identifier")
    sp.add_argument(
        "--print",
        dest="print_only",
        action="store_true",
        help="print the note path instead of opening it",
    )
    sp.set_defaults(fn=cmd_note)

    sp = sub.add_parser(
        "open",
        help="open the linked Linear issue in a browser — or the note, for "
        "tasks without one",
    )
    sp.add_argument("ref", help="taskwarrior task id, uuid, or Linear identifier")
    sp.set_defaults(fn=cmd_open)

    sp = sub.add_parser(
        "show",
        help="show a task with its issue/milestone/project and what it blocks on",
    )
    sp.add_argument("ref", help="taskwarrior task id, uuid, or Linear identifier")
    sp.set_defaults(fn=cmd_show)

    sp = sub.add_parser(
        "done",
        help="complete a task; issue-tasks also move the Linear issue to Done "
        "(subtasks/umbrellas never touch Linear)",
    )
    sp.add_argument("ref", help="taskwarrior task id, uuid, or Linear identifier")
    sp.set_defaults(fn=cmd_done)

    sp = sub.add_parser(
        "sync",
        help="push: export task DB + commit notes dir + git push · "
        "pull: git pull + uuid-upsert import",
    )
    sp.add_argument(
        "direction",
        choices=["push", "pull"],
        help="push: export + commit + push · pull: pull + import + mirror notes",
    )
    sp.set_defaults(fn=cmd_sync)

    sp = sub.add_parser(
        "here",
        help="list tasks whose work dirs (workdirs.toml) cover $PWD; "
        "--notes prints existing note paths for agents",
    )
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.add_argument(
        "--notes",
        action="store_true",
        help="print resolved note paths that exist (agent context)",
    )
    sp.add_argument("--dir", help="use this directory instead of $PWD")
    sp.set_defaults(fn=cmd_here)

    sp = sub.add_parser(
        "map",
        help="add (or --remove) a work dir for a project/issue/milestone "
        "in workdirs.toml; milestone dirs inherit to their issues",
    )
    sp.add_argument(
        "ref",
        help="issue ident (VOIP-1), task id/uuid, milestone 8-hex "
        "prefix, or TW project key (VOIP / VOIP.slug)",
    )
    sp.add_argument("directory", help="work directory (~/... allowed)")
    sp.add_argument(
        "--remove", action="store_true", help="remove the dir instead of adding it"
    )
    sp.set_defaults(fn=cmd_map)

    sp = sub.add_parser(
        "context",
        help="activate a taskwarrior context scoping reports/tui to a "
        "project/issue/milestone + children; 'none' clears, 'list' shows",
    )
    sp.add_argument(
        "ref",
        help="issue ident, task id/uuid, milestone prefix, TW "
        "project key — or 'none' to clear, 'list' to show",
    )
    sp.set_defaults(fn=cmd_context)

    sp = sub.add_parser(
        "sod",
        help="start of day: +active tasks, notes' '## Next steps' sections, "
        "due/overdue — the deterministic core of the tw-start skill",
    )
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.set_defaults(fn=cmd_sod)

    sp = sub.add_parser(
        "eod",
        help="end of day: tasks finished/added/changed + notes edited in the "
        "last 24h (rolling window), latest EOD journal — core of tw-eod",
    )
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.set_defaults(fn=cmd_eod)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
