# --------------------------------------------------------------------------
# Git-based sync (tasks + task notes between machines)
#
# The git root IS the notes dir (<vault>/Tasks): notes live directly in the
# working tree, so git tracks them with no copying. Only the task DB needs a
# bridge — `task export` writes tasks.json into the repo, `task import`
# upserts it back by uuid.

SYNC_REPO = Path(os.environ.get("TWL_SYNC_REPO", str(TASKS_DIR)))


def git(*args, check=True):
    r = subprocess.run(
        ["git", "-C", str(SYNC_REPO), *args], capture_output=True, text=True
    )
    if check and r.returncode != 0:
        die(f"git -C {SYNC_REPO} {' '.join(args)} failed: {r.stderr.strip()}")
    return r


def git_out(*args):
    return git(*args).stdout.strip()


def ensure_sync_repo():
    SYNC_REPO.mkdir(parents=True, exist_ok=True)
    if not (SYNC_REPO / ".git").exists():
        git("init", "-q")
    gi = SYNC_REPO / ".gitignore"
    if not gi.exists():
        gi.write_text(".DS_Store\n")


def git_pull_rebase():
    """Returns True when up to date / pulled cleanly, False on conflict."""
    if not git_out("remote"):
        return True  # no remote yet — local repo only
    return git("pull", "--rebase", check=False).returncode == 0


def sync_push():
    ensure_sync_repo()
    if not git_pull_rebase():
        die(f"git pull conflict — resolve in {SYNC_REPO}, then re-run")
    # `task export` covers ALL statuses (pending/completed/deleted), so
    # completions and deletions propagate as tombstones; `task import`
    # upserts by uuid. Export is one task per line → git merges cleanly
    # unless the same task changed on both machines.
    (SYNC_REPO / "tasks.json").write_text(task("export"))
    if git_out("status", "--porcelain"):
        git("add", "-A")
        git(
            "commit",
            "-q",
            "-m",
            f"sync {socket.gethostname()} {datetime.now().strftime('%Y-%m-%d %H:%M')}",
        )
    print(f"synced local state → {SYNC_REPO}")
    if git_out("remote"):
        git("push")
        print("pushed to remote")
    else:
        print(
            "no remote configured — add one with: "
            f"git -C {SYNC_REPO} remote add origin <url>"
        )


def sync_pull():
    ensure_sync_repo()
    if not git_pull_rebase():
        die(f"git pull conflict — resolve in {SYNC_REPO}, then re-run")
    tj = SYNC_REPO / "tasks.json"
    if tj.exists():
        # import emits per-task action lines on stdout: add/mod/del/skip
        out = task("import", str(tj))
        counts = {
            a: len(re.findall(rf"^\s*{a}\s", out, re.M))
            for a in ("add", "mod", "del", "skip")
        }
        print(
            f"taskwarrior: {counts['add']} added, {counts['mod']} updated, "
            f"{counts['del']} deleted, {counts['skip']} unchanged"
        )


def cmd_sync(args):
    if args.direction == "push":
        sync_push()
    else:
        sync_pull()


